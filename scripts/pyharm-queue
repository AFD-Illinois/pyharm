import os
import sys
import click
import glob
import h5py
import numpy as np
import glob

from astropy.io import ascii
from astropy.table import Table

import pyharm
# Really only support kharma for now, will write abstract versions if necessary
import pyharm.io.logs_kharma as kio
from pyharm.defs import JobReturn
from pyharm.ana.info import SimulationRun

@click.command()
@click.argument('op', nargs=1)
@click.argument('paths', nargs=-1, type=click.Path(exists=True))
@click.option('--file-glob', default=None, help="Expression to use to find log files. Default *.out, *.txt")
@click.version_option(package_name='pyharm')
def queue(op, paths, **kwargs):
    """This is a utility for interacting with batch queues and KHARMA -- currently slurm-only.
    It can check up on run progress and flag stalled runs, problematic runs, and so on
    """

    # TODO
    # last file written timestamp
    # is 'final' written more recently than the last numbered restart?
    #    Is it readable?
    #    Partially written w/some zeros?
    #    Is it farther in sim time?

    # run current time (last time=)
    # run average timestep, hours to completion @ this timestep

    # Detect partial restart files

    if op in ["all_returns", "current", "running"]:
        cols = ('run_name', 'jobnum', 'status_str', 'simtime', 'perf', 'floors_pct','pflags_pct')
        table = Table(names=SimulationRun.table_names(cols),
                      dtype=SimulationRun.table_types(cols))
        for pathname in paths:
            try:
                sim_status = SimulationRun(pathname, n_dumps_to_load=0)
            except Exception as e:
                print(e)
                continue
            
            # Skip non-running jobs if we're restricting to running
            if op == "running" and sim_status['status'] != JobReturn.RUNNING:
                continue

            table.add_row(sim_status.table_row(cols), mask=sim_status.table_mask(cols))

        ascii.write(table, sys.stdout, format='fixed_width')

    # op == prep: ensure final is last-written & last in sim, link or move things otherwise

    # op == stack: submit a job from a template
    # default to naming it according to current folder
    # depend on any job running submitted from current dir

if __name__ == "__main__":
    queue()
