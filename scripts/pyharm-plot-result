from argparse import ArgumentError
import sys
import glob
import click
import inspect
import textwrap

import numpy as np
import matplotlib.pyplot as plt

import pyharm
from pyharm.plots import result_figures
from pyharm.defs import Loci

# This extends the help message to print valid plots
class ExtensibleCmd(click.Command):
    def format_help(self, ctx, formatter):
        click.Command.format_help(self, ctx, formatter)

        figure_list = inspect.getmembers(result_figures, \
                predicate=lambda f: inspect.isfunction(f) and f.__module__ == result_figures.__name__)

        formatter.write("\nValid figures:\n")
        for fnname, fn in figure_list:
            if fnname[0] != "_":
                formatter.write("  "+fnname+":\n")
                if result_figures.__dict__[fnname].__doc__ is not None:
                    # Take out all whitespace from the docstring
                    docstring = textwrap.shorten(result_figures.__dict__[fnname].__doc__, 1e6).replace("\n"," ")
                    # Reflow and indent
                    formatter.write(textwrap.indent(textwrap.fill(docstring), "    ") + "\n\n")

@click.command(cls=ExtensibleCmd)
@click.argument('plot_type', nargs=1)
@click.argument('files', nargs=-1, type=click.Path(exists=True))
@click.option('--varlist', default=None, help="Comma-separated list of variables to use")
@click.option('--tag', default="compare", help="String to add to output plot names")
@click.option('--file-tags', default=None, help="Comma-separated list of names/tags for result files")
@click.option('--prefer-hst', is_flag=True, help="Prefer KHARMA's fluxes to post-processing values")
@click.option('--plot-std', is_flag=True, help="Plot standard deviations on averaged quantities")
@click.option('--plot-eh/--no-plot-eh', default=False, help="Mark event horizon where relevant")
@click.option('-v', '--verbose', is_flag=True, help="Print each plot for debugging")
@click.option('--stats', is_flag=True, help="Print stats (max, avg) for variables")
# Bounds
@click.option('--logy/--no-logy', default=False, help="Logarithmic Y-axis")
@click.option('--logx/--no-logx', default=False, help="Logarithmic X-axis")
@click.option('--xmax', type=float, default=None, help="X-axis maximum")
@click.option('--xmin', type=float, default=None, help="X-axis minimum")
@click.option('--ymax', type=float, default=None, help="Y-axis maximum")
@click.option('--ymin', type=float, default=None, help="Y-axis minimum")
@click.option('--ymin-prop', type=float, default=None, help="Y-axis minimum as a proportion of maximum (i.e. 1e-5 for 5 decades)")
# Bounds on particular plots
@click.option('--one-ymin', type=(int, float), multiple=True, help="Y-axis minimum for a particular plot: axis num, lim")
@click.option('--one-ymax', type=(int, float), multiple=True, help="Y-axis maximum for a particular plot: axis num, lim")
# Time bounds
@click.option('--avg-min', type=float, default=None, help="Time-average minimum. Negative value counts backward from end of run")
@click.option('--avg-max', type=float, default=None, help="Time-average maximum")
@click.option('--show-avg/--hide-avg', default=False, help="Whether to show and annotate averaged values")
@click.option('--avg-is-smooth', is_flag=True, help="Compute all averaged values as smoothed instead")
@click.option('--by-window', is_flag=True, help="Plot a point or line for each window of a series")
@click.option('--per', is_flag=True, help="Normalize by instantaneous accretion rate")
# Output
@click.option('--legend-plot', default="1", help="Number of plot to place legend, or \"above\" or \"right\"")
@click.option('--legend-loc', type=str, default="best", help="Legend location string")
@click.option('-pdf', '--pdf', is_flag=True, help="Output to .pdf file rather than .png image")
@click.option('--fig-title', type=str, default=None, help="Figure title")
@click.option('--fig-x', type=float, default=None, help="Figure width in inches")
@click.option('--fig-y', type=float, default=None, help="Figure height in inches")
@click.option('--fig-dpi', type=int, default=300, help="Figure resolution in dots per inch")
@click.option('--fig-left', type=float, default=None, help="Left margin in subplots_adjust")
@click.option('--fig-right', type=float, default=None, help="Right margin in subplots_adjust")
@click.option('--fig-top', type=float, default=None, help="Top margin in subplots_adjust")
@click.option('--fig-bottom', type=float, default=None, help="Bottom margin in subplots_adjust")
@click.option('--fig-wspace', type=float, default=None, help="Width spacing in subplots_adjust")
@click.option('--fig-hspace', type=float, default=None, help="Height spacing in subplots_adjust")
@click.version_option(package_name='pyharm')
def plot_results(plot_type, files, **kwargs):
    """Plot a result or set of results in a standard form, usually the contents of one or more
    analyses done by pyharm-analysis.

    Usage: pyharm-plot-result plot_type [options] file1.h5 [file2.h5 ...]
    """
    
    ## PROCESS ARGUMENTS
    # TODO click does lists
    if kwargs['varlist'] is not None:
        kwargs['varlist'] = kwargs['varlist'].split(",")

    # Make any int/real or None into their actual types
    if kwargs['avg_min'] is not None:
        if kwargs['avg_max'] is not None:
            kwargs['arange'] = (kwargs['avg_min'], kwargs['avg_max'])
        else:
            kwargs['arange'] = kwargs['avg_min']
    else:
        kwargs['arange'] = None
    #print(f"Running with arange {kwargs['arange']}")

    # TODO if file is folder attempt to read eht_out.h5, then whatever h5

    # Always load results
    if kwargs['file_tags'] is not None:
        tags = kwargs['file_tags'].split(",")
        results = []
        for f, t in zip(files, tags):
            try:
                results.append(pyharm.load_result(f, tag=t, avg_ends=kwargs['arange'], prefer_hst=kwargs['prefer_hst']))
            except:
                print(f"ERROR reading result file {f}, omitting!")
    else:
        # Will be auto-tagged as folder names
        results = []
        for f in files:
            try:
                results.append(pyharm.load_result(f, avg_ends=kwargs['arange'], prefer_hst=kwargs['prefer_hst']))
            except:
                print(f"ERROR reading result file {f}, omitting!")

    ## CALL FUNCTION
    # Hack to call a function in result_figures by name
    figure_list = inspect.getmembers(result_figures, \
            predicate=lambda f: inspect.isfunction(f) and f.__module__ == result_figures.__name__)
    local_fns = {}
    for fnname, fn in figure_list:
        local_fns[fnname] = fn
    # One function on all results
    if plot_type in local_fns.keys():
        figs = result_figures.__dict__[plot_type](results, kwargs=kwargs)
    else:
        print("ERROR: Cannot make plot: {}".format(plot_type))
        exit(-1)

    ## COMMON FORMATTING & LABELING
    # Allow, but do not require, returning multiple figures saved as different images
    try:
        figs[0]
    except:
        figs = [figs]
    for fig in figs:
        axes = fig.get_axes()
        # Legend: usually first plot
        if kwargs['legend_plot'] == "right":
            axes[0].legend(loc='upper left', bbox_to_anchor=(1.03, 1.0))
            if kwargs['fig_right'] is None:
                kwargs['fig_right'] = 0.75
            if kwargs['fig_wspace'] is None:
                kwargs['fig_wspace'] = 0.4
        elif kwargs['legend_plot'] == "above":
            axes[0].legend(loc='lower left', bbox_to_anchor=(0, 1.02, 1, 0.2))
            if kwargs['fig_top'] is None:
                kwargs['fig_top'] = 0.8
            if kwargs['fig_wspace'] is None:
                kwargs['fig_wspace'] = 0.4
        elif kwargs['legend_plot'] == "none" or kwargs['legend_plot'] == "off":
            if kwargs['fig_wspace'] is None:
                kwargs['fig_wspace'] = 0.4
        else:
            axes[int(kwargs['legend_plot'])-1].legend(loc=kwargs['legend_loc'].replace("-"," "))

        for i,ax in enumerate(axes):
            ax.set_xlim(kwargs['xmin'],  kwargs['xmax'])
            ax.set_ylim(kwargs['ymin'],  kwargs['ymax'])

        # this allows both options to be specified
        if kwargs['one_ymin'] is not None:
            for ymin_tuple in kwargs['one_ymin']:
                ymax = None
                if kwargs['one_ymax'] is not None:
                    for ymax_tuple in kwargs['one_ymax']:
                        if ymin_tuple[0] == ymax_tuple[0]:
                            ymax = ymax_tuple[1]

                axes[ymin_tuple[0]-1].set_ylim((ymin_tuple[1], ymax))

        if kwargs['one_ymax'] is not None:
            for ymax_tuple in kwargs['one_ymax']:
                if kwargs['one_ymin'] is not None and \
                    ymax_tuple[0] in [t[0] for t in kwargs['one_ymin']]:
                    continue
                axes[ymax_tuple[0]-1].set_ylim((None, ymax_tuple[1]))

        # User tag (or file, if one file), then fn, then extension
        if len(results) == 1 and kwargs['tag'] == "compare":
            out_name = results[0].tag+"_"+plot_type
        else:
            out_name = kwargs['tag'].rstrip("_")+"_"+plot_type

        if kwargs['fig_title'] is not None:
            fig.suptitle(kwargs['fig_title'])

        # Reshape, output
        plt.subplots_adjust(left=kwargs['fig_left'], right=kwargs['fig_right'],
                            top=kwargs['fig_top'], bottom=kwargs['fig_bottom'],
                            wspace=kwargs['fig_wspace'], hspace=kwargs['fig_hspace'])
        fig.savefig(out_name+(".pdf" if kwargs['pdf'] else ".png"), dpi=kwargs['fig_dpi'])
        plt.close(fig)

if __name__ == "__main__":
    plot_results()

